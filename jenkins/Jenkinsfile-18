                            if (buildResult != 0) {
                                error("Docker build failed")
                            }                            
                            
                            def scanResult = sh(returnStatus: true, 
                                script: 'trivy image --severity HIGH,CRITICAL "${IMAGE_NAME}:${IMAGE_TAG}" > trivy_result.txt')
                            if (scanResult != 0) {
                                error("Scan failed")
                            }

                            def pushResult = sh(returnStatus: true, 
                                script: 'docker push "${IMAGE_NAME}:${IMAGE_TAG}"')
                            if (pushResult != 0) {
                                   error("Push failed")
                            }
                    }
                    
                }
            }
        }
    
    
        stage ('Test') {
            steps {
                script {
                    sh 'mkdir -p "$WORKSPACE/test-reports"'
                    sh 'rm -f "$WORKSPACE/test-reports/*"'

                    dir('docker-compose') {
                        try {
                            env.PREVIOUS_IMAGE_TAG = readFile(file: "current_image_tag.txt").trim()
                        } catch(err) {
                            echo "Unable to read current_image_tag.txt: ${err}"
                        }
                        writeFile(file: "current_image_tag.txt", text: "${env.IMAGE_TAG}")

                        withCredentials([file(credentialsId: 'cicd-credentials', variable: 'ENV_FILE')]) {
                            withEnv(["IMAGE_NAME=${eventAppPrivateImageName}"]) {
                                def buildResult = sh(returnStatus: true, 
                                    script: 'docker compose --env-file "$ENV_FILE" -f docker-compose-test5.yaml up \
