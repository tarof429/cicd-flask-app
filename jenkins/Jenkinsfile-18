                                "IMAGE=${publicEventAppRepository}", 
                                "EVENT_CONSUMER_IMAGE=${publicEventConsumerRepository}"
                                ]) {
                            
                                def buildStatus = sh(returnStatus: true, script: 'docker build -t "${IMAGE}:${IMAGE_TAG}" -f docker/Dockerfile3 .')

                                if (buildStatus != 0) {
                                    error("Unable to build '$IMAGE'")
                                }

                                def loginStatus = sh(returnStatus: true, script: 'echo $PASS | docker login -u "$USER" --password-stdin')

                                if (loginStatus != 0) {
                                    error("Unable to login to dockerhub")
                                }

                                def pushStatus = sh(returnStatus: true, script: 'docker push "$IMAGE"')

                                if (pushStatus != 0) {
                                    error("Unable to push $IMAGE")
                                }

                                def tagStatus = sh(returnStatus: true, script: 'docker tag "${IMAGE}:${IMAGE_TAG}" "${IMAGE}:latest"')

                                if (tagStatus != 0) {
                                    error("Unable to create ${IMAGE}:latest")
                                }

                                pushStatus = sh(returnStatus: true, script: 'docker push "${IMAGE}:latest"')

                                if (pushStatus != 0) {
                                    error("Unable to push ${IMAGE}:latest")
                                }

                                dir('go/event-consumer') {
        
                                    buildStatus = sh(returnStatus: true, script: 'docker build -t "${EVENT_CONSUMER_IMAGE}:${IMAGE_TAG}" .')

                                    if (buildStatus != 0) {
                                        error("Unable to tag ${EVENT_CONSUMER_IMAGE}:${IMAGE_TAG}")
                                    }

                                    pushStatus = sh(returnStatus: true, script: 'docker push "${EVENT_CONSUMER_IMAGE}:${IMAGE_TAG}"')

                                    if (pushStatus != 0) {
                                        error("Unable to push ${EVENT_CONSUMER_IMAGE}:${IMAGE_TAG}")
                                    }

                                    tagStatus = sh(returnStatus: true, script: 'docker tag "${EVENT_CONSUMER_IMAGE}:${IMAGE_TAG}" "${EVENT_CONSUMER_IMAGE}:latest"')

                                    if (tagStatus != 0) {
                                        error("Unable to tag ${EVENT_CONSUMER_IMAGE}:latest")
                                    }

                                    pushStatus = sh(returnStatus: true, script: 'docker push "${EVENT_CONSUMER_IMAGE}:latest"')

                                    if (pushStatus != 0) {
                                        error("Unable to push ${EVENT_CONSUMER_IMAGE}:latest")
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

