#!/usr/bin/groovy

def cloudProvider
def privateRegistryServer
def privateRegistryPort
def deploymentUser
def deploymentServer

def privateEventAppRepository
def publicEventAppRepository
def privateEventConsumerRepository
def publicEventConsumerRepository
def runtimeMode

def dbUser
def dbPass
def dbHost
def dbPort
def dbName

def privateEventAppImageName
def publicEventAppImageName

def imageTag

def tmpCredFile

pipeline {
    agent any

    stages {
        stage('Pre') {
            steps {
                script {
                    withCredentials([file(credentialsId: 'cicd-credentials', variable: 'ENV_FILE')]) {
                        def values = sh(
                            returnStdout: true,
                            script: '''
                                set +x
                                set -eu
                                . "$ENV_FILE"
                                printf '%s\\t%s\\t%s\\t%s\\t%s' \
                                    "${CLOUD_PROVIDER}" \
                                    "${PRIVATE_REGISTRY_SERVER}" \
                                    "${PRIVATE_REGISTRY_PORT}" \
                                    "${DEPLOYMENT_USER}" \
                                    "${DEPLOYMENT_SERVER}"
                            ''').trim().split('\\t')
                        cloudProvider = values[0]
                        privateRegistryServer = values[1]
                        privateRegistryPort = values[2]
                        deploymentUser = values[3]
                        deploymentServer = values[4]

                        // echo "cloudProvider: ${cloudProvider}"
                        // echo "privateRegistryServer: ${privateRegistryServer}"
                        // echo "privateRegistryPort: ${privateRegistryPort}"
                        // echo "deploymentUser: ${deploymentUser}"
                        // echo "deploymentServer: ${deploymentServer}"

                        values = sh(
                            returnStdout: true,
                            script: '''
                                set +x
                                set -eu
                                . "$ENV_FILE"
                                printf '%s\\t%s\\t%s\\t%s\\t%s' \
                                    "${PRIVATE_EVENT_APP_REPOSITORY}" \
                                    "${PUBLIC_EVENT_APP_REPOSITORY}" \
                                    "${PRIVATE_EVENT_CONSUMER_REPOSITORY}" \
                                    "${PUBLIC_EVENT_CONSUMER_REPOSITORY}" \
                                    "${RUNTIME_MODE}"
                            ''').trim().split('\\t')

                        privateEventAppRepository = values[0]
                        publicEventAppRepository = values[1]
                        privateEventConsumerRepository = values[2]
                        publicEventConsumerRepository = values[3]
                        runtimeMode = values[4]

                        // echo "privateEventAppRepository: ${privateEventAppRepository}"
                        // echo "publicEventAppRepository: ${publicEventAppRepository}"
                        // echo "privateEventConsumerRepository: ${privateEventConsumerRepository}"
                        // echo "publicEventConsumerRepository: ${publicEventConsumerRepository}"
                        // echo "runtimeMode: ${runtimeMode}"

                       values = sh(
                            returnStdout: true,
                            script: '''
                                set +x
                                set -eu
                                . "$ENV_FILE"
                                printf '%s\\t%s\\t%s\\t%s\\t%s' \
                                    "${DB_USER}" \
                                    "${DB_PASS}" \
                                    "${DB_HOST}" \
                                    "${DB_PORT}" \
                                    "${DB_NAME}"
                            ''').trim().split('\\t')

                        dbUser = values[0]
                        dbPass = values[1]
                        dbHost = values[2]
                        dbPort = values[3]
                        dbName = values[4]

                        // echo "dbUser: ${dbUser}"
                        // echo "dbPass: ${dbPass}"
                        // echo "dbHost: ${dbHost}"
                        // echo "dbPort: ${dbPort}"
                        // echo "dbName: ${dbName}"

                        privateEventAppImageName = "${privateRegistryServer}:${privateRegistryPort}/${privateEventAppRepository}"
                        echo "privateEventAppImageName: ${privateEventAppImageName}"

                        publicEventAppImageName = "${publicEventAppRepository}"
                        echo "publicEventAppImageName: ${publicEventAppImageName}"
                    }
                }
            }
        }
        
        stage('Build') {
            steps {
                script {
                    def COMMIT_HASH = sh(
                        script: 'git rev-parse --short HEAD',
                        returnStdout: true
                    ).trim()

                    env.IMAGE_TAG = "${COMMIT_HASH}-${env.BUILD_NUMBER}"

                    withEnv([
                        "IMAGE_NAME=${privateEventAppImageName}",
                        "EVENTCONSUMER_IMAGE_NAME=${privateEventConsumerRepository}"
                    ]) {
                            def buildResult

                            dir('go/event-consumer') {
                                buildResult = sh(returnStatus: true, 
                                    script: 'docker build -t "${EVENTCONSUMER_IMAGE_NAME}:${IMAGE_TAG}" .')

                                if (buildResult != 0) {
                                    error("Unable to tag ${EVENTCONSUMER_IMAGE_NAME}:${IMAGE_TAG}")
                                }
                            }

                            buildResult = sh(returnStatus: true, 
                                script: 'docker build -t  "${IMAGE_NAME}:${IMAGE_TAG}" -f docker/engine/Dockerfile .')
                            if (buildResult != 0) {
                                error("Docker build failed")
                            }                            
                            
                            def scanResult = sh(returnStatus: true, 
                                script: 'trivy image --severity HIGH,CRITICAL "${IMAGE_NAME}:${IMAGE_TAG}" > trivy_result.txt')
                            if (scanResult != 0) {
                                error("Scan failed")
                            }

                            def pushResult = sh(returnStatus: true, 
                                script: 'docker push "${IMAGE_NAME}:${IMAGE_TAG}"')
                            if (pushResult != 0) {
                                   error("Push failed")
                            }
                    }
                    
                }
            }
        }
    
    
        stage ('Test') {
            steps {
                script {
                    sh 'mkdir -p "$WORKSPACE/test-reports"'
                    sh 'rm -f "$WORKSPACE/test-reports/*"'

                    dir('docker/compose') {
                        try {
                            env.PREVIOUS_IMAGE_TAG = readFile(file: "current_image_tag.txt").trim()
                        } catch(err) {
                            echo "Unable to read current_image_tag.txt: ${err}"
                        }
                        writeFile(file: "current_image_tag.txt", text: "${env.IMAGE_TAG}")

                        withCredentials([file(credentialsId: 'cicd-credentials', variable: 'ENV_FILE')]) {
                            withEnv(["IMAGE_NAME=${privateEventAppImageName}",
                                "EVENTCONSUMER_IMAGE_NAME=${privateEventConsumerRepository}"
                            ]) {
                                def buildResult = sh(returnStatus: true, 
                                    script: 'docker compose --env-file "$ENV_FILE" -f docker-compose.yaml run \
                                        --rm --entrypoint python app -m pytest')
                                
                                if (buildResult != 0) {
                                    error("Docker compose failed")
                                }

                                def teardownResult = sh(returnStatus: true, script: 'docker compose down') 

                                if (teardownResult != 0) {
                                    error("Unable to teardown")
                                }
                            }
                        }
                    }
                }
            }
        }

        stage ('Publish') {
            steps {
                script {
                    withCredentials([
                        usernamePassword(credentialsId: 'dockerhub', passwordVariable: 'PASS', usernameVariable: 'USER'),
                        file(credentialsId: 'cicd-credentials', variable: 'ENV_FILE')
                    ]){
                        withEnv([
                                "IMAGE_NAME_PUBLIC=${publicEventAppImageName}",
                                "EVENTCONSUMER_IMAGE_NAME_PUBLIC=${publicEventConsumerRepository}",
                                "IMAGE_NAME_PRIVATE=${privateEventAppImageName}",
                                "EVENTCONSUMER_IMAGE_NAME_PRIVATE=${privateEventConsumerRepository}"
                                ]) {
                            
                                def loginStatus = sh(returnStatus: true, script: 'echo $PASS | docker login -u "$USER" --password-stdin')

                                if (loginStatus != 0) {
                                    error("Unable to login to dockerhub")
                                }

                                // Push Event App
                                def buildStatus = sh(returnStatus: true, script: 'docker tag "${IMAGE_NAME_PRIVATE}:${IMAGE_TAG}" \
                                    "${IMAGE_NAME_PUBLIC}:${IMAGE_TAG}"')

                                if (buildStatus != 0) {
                                    error("Unable to tag $IMAGE_NAME_PRIVATE:$IMAGE_TAG")
                                }

                                def pushStatus = sh(returnStatus: true, script: 'docker push "${IMAGE_NAME_PUBLIC}:${IMAGE_TAG}"')

                                if (pushStatus != 0) {
                                    error("Unable to push $IMAGE_NAME_PUBLIC:$IMAGE_TAG")
                                }

                                def tagStatus = sh(returnStatus: true, script: 'docker tag "${IMAGE_NAME_PRIVATE}:${IMAGE_TAG}" \
                                    "${IMAGE_NAME_PUBLIC}:latest"')

                                if (tagStatus != 0) {
                                    error("Unable to create ${IMAGE_NAME_PUBLIC}:latest")
                                }

                                pushStatus = sh(returnStatus: true, script: 'docker push "${IMAGE_NAME_PUBLIC}:latest"')

                                if (pushStatus != 0) {
                                    error("Unable to push ${IMAGE_NAME_PUBLIC}:latest")
                                }

        
                                // EventConsumer
                                tagStatus = sh(returnStatus: true, script: 'docker tag "${EVENTCONSUMER_IMAGE_NAME_PRIVATE}:${IMAGE_TAG}" \
                                    "${EVENTCONSUMER_IMAGE_NAME_PUBLIC}:${IMAGE_TAG}"')

                                if (tagStatus != 0) {
                                    error("Unable to tag $EVENTCONSUMER_IMAGE_NAME_PUBLIC:$IMAGE_TAG")
                                }

                                pushStatus = sh(returnStatus: true, script: 'docker push "${EVENTCONSUMER_IMAGE_NAME_PUBLIC}:${IMAGE_TAG}"')

                                if (pushStatus != 0) {
                                    error("Unable to push $EVENTCONSUMER_IMAGE_NAME_PUBLIC:$IMAGE_TAG")
                                }

                                tagStatus = sh(returnStatus: true, script: 'docker tag "${EVENTCONSUMER_IMAGE_NAME_PRIVATE}:${IMAGE_TAG}" \
                                    "${EVENTCONSUMER_IMAGE_NAME_PUBLIC}:latest"')

                                if (tagStatus != 0) {
                                    error("Unable to tag $EVENTCONSUMER_IMAGE_NAME_PUBLIC:latest")
                                }

                                pushStatus = sh(returnStatus: true, script: 'docker push "${EVENTCONSUMER_IMAGE_NAME_PUBLIC}:latest"')

                                if (pushStatus != 0) {
                                    error("Unable to push $EVENTCONSUMER_IMAGE_NAME_PUBLIC:latest")
                                }
                                

                                // Cleanup
                                def cleanupStatus

                                cleanupStatus =  sh(returnStatus: true, script: 'docker image rm "${IMAGE_NAME_PRIVATE}:${IMAGE_TAG}"')

                                if (cleanupStatus != 0) {
                                    echo("Unable to remove $IMAGE_NAME_PRIVATE:$IMAGE_TAG")
                                }

                                cleanupStatus =  sh(returnStatus: true, script: 'docker image rm "${IMAGE_NAME_PUBLIC}:${IMAGE_TAG}"')

                                if (cleanupStatus != 0) {
                                    echo("Unable to remove $IMAGE_NAME_PUBLIC:$IMAGE_TAG")
                                }

                                cleanupStatus =  sh(returnStatus: true, script: 'docker image rm "${EVENTCONSUMER_IMAGE_NAME_PRIVATE}:${IMAGE_TAG}"')

                                if (cleanupStatus != 0) {
                                    echo("Unable to remove $EVENTCONSUMER_IMAGE_NAME_PRIVATE:$IMAGE_TAG")
                                }
                            
                                cleanupStatus =  sh(returnStatus: true, script: 'docker image rm "${EVENTCONSUMER_IMAGE_NAME_PUBLIC}:${IMAGE_TAG}"')

                                if (cleanupStatus != 0) {
                                    echo("Unable to remove $EVENTCONSUMER_IMAGE_NAME_PUBLIC:$IMAGE_TAG")
                                }
                        }
                        
                    }
                }
            }
        }

        stage ('Deploy to KVM') {
            when {
                expression {
                    cloudProvider == 'KVM'
                }
            }
            steps {
                script {
                    sshagent(['cicd-server-key']) {
                    withCredentials([
                        file(credentialsId: 'cicd-credentials', variable: 'ENV_FILE')
                    ]){
                        withEnv([
                            "IMAGE_NAME=${publicEventAppImageName}",
                            "EVENTCONSUMER_IMAGE_NAME=${publicEventConsumerRepository}",
                            "IMAGE_TAG=${env.IMAGE_TAG}",
                            "DEPLOYMENT_USER=${deploymentUser}",
                            "DEPLOYMENT_SERVER=${deploymentServer}",
                        ]) {
                                dir('docker/compose') {
                                    sh 'scp docker-compose.yaml "${DEPLOYMENT_USER}"@"${DEPLOYMENT_SERVER}":docker-compose.yaml'

                                    tmpCredFile = sh(returnStdout: true,
                                        script: 'ssh "${DEPLOYMENT_USER}"@"${DEPLOYMENT_SERVER}" \
                                            mktemp cicd-credentials-XXXX')
                                    
                                    tmpCredFile = tmpCredFile.trim()

                                    withEnv(["TMPCREDFILE=${tmpCredFile}"]) {
                                        sh 'scp "$ENV_FILE" "${DEPLOYMENT_USER}"@"${DEPLOYMENT_SERVER}":"${TMPCREDFILE}"'

                                        def buildResult = sh(returnStatus: true, 
                                            script: 'ssh "${DEPLOYMENT_USER}"@"${DEPLOYMENT_SERVER}" \
                                                IMAGE_NAME="${IMAGE_NAME}" \
                                                EVENTCONSUMER_IMAGE_NAME="${EVENTCONSUMER_IMAGE_NAME}" \
                                                IMAGE_TAG="${IMAGE_TAG}" docker compose --env-file "${TMPCREDFILE}" -f docker-compose.yaml up \
                                                -d --force-recreate app eventconsumer')

                                        if (buildResult != 0) {
                                            error("Docker compose failed")
                                        }
                                    }

                                    writeFile(file: "current_image_tag.txt", text: "${env.IMAGE_TAG}")
                                }

                                dir('bash') {
                                    sh 'scp -o StrictHostKeyChecking=no app_is_up.sh "${DEPLOYMENT_USER}"@"${DEPLOYMENT_SERVER}":app_is_up.sh'
                                }

                                sh 'ssh -o StrictHostKeyChecking=no "${DEPLOYMENT_USER}"@"${DEPLOYMENT_SERVER}" chmod +x app_is_up.sh'

                                def status = sh(returnStatus: true, script: 'ssh -o StrictHostKeyChecking=no "${DEPLOYMENT_USER}"@"${DEPLOYMENT_SERVER}" ./app_is_up.sh')

                                if (status != 0) {
                                    error("App is not running!")
                                }
                                
                                // Queue removal on the deployment server
                                if (env.PREVIOUS_IMAGE_TAG) {
                                    sh '''
                                        ssh -o StrictHostKeyChecking=no "${DEPLOYMENT_USER}"@"${DEPLOYMENT_SERVER}" \
                                            "echo 'docker rmi "${EVENT_APP_REPOSITORY}:${PREVIOUS_IMAGE_TAG}"' | at now + 5 minutes"
                                        '''

                                    sh '''
                                        ssh -o StrictHostKeyChecking=no "${DEPLOYMENT_USER}"@"${DEPLOYMENT_SERVER}" \
                                            "echo 'docker rmi "${EVENT_CONSUMER_REPOSITORY}":"${PREVIOUS_IMAGE_TAG}"' | at now + 5 minutes"
                                        '''
                                }
                            }
                        }
                    }
                }
            }
        }

        stage ('Deploy to DO') {
            when {
                expression {
                    cloudProvider == 'DO'
                }
            }
            steps {
                script {
                    sshagent(['cicd-server-key']) {
                        withCredentials([
                            file(credentialsId: 'ansible-vault-file',
                                variable: 'VAULT_FILE'),

                            file(credentialsId: 'ansible-vault-password',
                                variable: 'VAULT_PASSWORD_FILE')
                        ]) {
                        withEnv([
                            "IMAGE_NAME=${publicEventAppImageName}",
                            "EVENTCONSUMER_IMAGE_NAME=${publicEventConsumerRepository}",
                            "IMAGE_TAG=${env.IMAGE_TAG}",
                            "DEPLOYMENT_SERVER=${deploymentServer}",
                            "PREVIOUS_IMAGE_TAG=${env.PREVIOUS_IMAGE_TAG}"
                        ]) {
                                dir('ansible') {
                                    def buildResult = sh(returnStatus: true, 
                                        script: 'ansible-playbook \
                                            -i inventory-do2.yaml \
                                            deploy_app.yaml \
                                            -e "IMAGE_NAME=${IMAGE_NAME}" \
                                            -e "EVENTCONSUMER_IMAGE_NAME=${EVENTCONSUMER_IMAGE_NAME}" \
                                            -e "IMAGE_TAG=${IMAGE_TAG}" \
                                            -e "DEPLOYMENT_SERVER=${DEPLOYMENT_SERVER}" \
                                            -e "PREVIOUS_IMAGE_TAG=${PREVIOUS_IMAGE_TAG}" \
                                            --vault-password-file "${VAULT_PASSWORD_FILE}"')
                                    if (buildResult != 0) {
                                        error("Ansible script failed")
                                    }
                                }

                                writeFile(file: "current_image_tag.txt", text: "${env.IMAGE_TAG}")
                            }
                        }
                    }
                }
            }
        }
    }


    post {
        always {
            script {
                sshagent(['cicd-server-key']) {
                    // Delete remote credentials file so it's not exposed for long!
                    if (tmpCredFile) {
                            withEnv([
                                "DEPLOYMENT_USER=${deploymentUser}",
                                "DEPLOYMENT_SERVER=${deploymentServer}",
                                "TMPCREDFILE=${tmpCredFile}"]) {
                                    sh 'ssh "${DEPLOYMENT_USER}"@"${DEPLOYMENT_SERVER}" rm -f "${TMPCREDFILE}"'
                                }
                            
                    }
                }

                withCredentials([usernamePassword(credentialsId: 'dockerhub', passwordVariable: 'PASS', usernameVariable: 'USER')]){
                    sh 'docker logout'
                }

                docker.image('alpine:latest').inside('-v test-reports:/source:ro') {
                    sh 'cp -f /source/*.xml "$WORKSPACE/test-reports/"'
                }
                sh 'mv -f "$WORKSPACE/trivy_result.txt" "$WORKSPACE/test-reports/"'
                                
                  sshagent(['cicd-server-key']) {
                        withEnv([
                            "DEPLOYMENT_SERVER=${deploymentServer}",
                        ]) {

                            dir('ansible') {
                                def buildResult = sh(returnStatus: true, 
                                    script: 'ansible-playbook -i inventory-do2.yaml \
                                    -e "DEPLOYMENT_SERVER=${DEPLOYMENT_SERVER}" \
                                    redact_docker_compose.yaml')
                                                        
                                if (buildResult != 0) {
                                    echo "Failed to redact ansible template"
                                }
                            }
                        }
                  }

            }
            junit allowEmptyResults: true, testResults: 'test-reports/*.xml'
            archiveArtifacts allowEmptyArchive: true, artifacts: 'test-reports/trivy_result.txt', followSymlinks: false
        }
    }
}
