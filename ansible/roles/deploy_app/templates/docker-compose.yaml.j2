services:
  app:
    image: tarof429/events-app:${IMAGE_TAG}
    environment:
      - FLASK_APP=events_app
      - FLASK_DEBUG=False
      - RUNTIME_MODE={{ RUNTIME_MODE }}
      - DATABASE_URI=postgresql://{{ DB_USER }}:{{ DB_PASS }}@{{ DB_HOST }}:{{ DB_PORT }}/{{ DB_NAME }}
      - MESSAGE_BROKER_TYPE={{ MESSAGE_BROKER_TYPE }}
      - RABBITMQ_USER=rabbit
      - RABBITMQ_PASS=secret
      - PREFERENCES_CONFIG=/prefs/preferences.yaml
    ports:
      - 5000:5000
    depends_on:
      rabbitmq:
        condition: service_healthy
        restart: true
      mailpit:
        condition: service_healthy
      eventconsumer:
        condition: service_started
    volumes:
      - "prefs:/prefs"
  rabbitmq:
    image: rabbitmq:4.3.6-management-alpine
    healthcheck:
      test: rabbitmq-diagnostics check_port_connectivity
      interval: 5s # check every 30 seconds
      timeout: 10s # Fail if the check takes longer than 10 seconds
      retries: 5 # Mark unhealthy after 3 consecutive failures
      start_period: 5s # grace period for startup
    restart: unless-stopped
    environment:
      - RABBITMQ_DEFAULT_USER=rabbit
      - RABBITMQ_DEFAULT_PASS=secret
      - RABBITMQ_DEFAULT_VHOST=rabbitmq
    ports:
      - 15672:15672
  eventconsumer:
    image: tarof429/event-consumer:${IMAGE_TAG}
    environment:
      - AMPQ_USER=rabbit
      - AMPQ_PASSWORD=secret
      - AMPQ_HOST=rabbitmq
      - AMPQ_PORT=5672
      - AMPQ_VHOST=rabbitmq
      - PREFERENCES_CONFIG=/prefs/preferences.yaml
    depends_on:
      rabbitmq:
        condition: service_healthy
        restart: true
    volumes:
      - "prefs:/prefs"
  mailpit:
    image: axllent/mailpit
    healthcheck:
      test: ["CMD-SHELL", "wget --spider --server-response http://localhost:8025/readyz 2>&1  | grep \"HTTP/\" | grep OK 2>& 1 > /dev/null"]
      interval: 5s # check every 30 seconds
      timeout: 10s # Fail if the check takes longer than 10 seconds
      retries: 5 # Mark unhealthy after 3 consecutive failures
      start_period: 5s # grace period for startup
    restart: unless-stopped
    ports:
      - 8025:8025
      - 1025:1025
volumes:
  prefs: